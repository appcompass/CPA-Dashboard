"YSP07": {
  "emotional": {
    "sub_emotional_1": "Therapy groups for young people in detention and in the community, including a therapeutic sports group on one detention unit and a group at a Charlestown education program.",
    "sub_emotional_2": "Outreach begins in the aftermath of an arrest or an incident of community violence, with referrals from the Boston Police Department, schools, hospitals and juvenile detention centers.",
    "sub_emotional_3": "Free individual therapy from trained social workers, with no insurance billing and no cap on how long a family is served; sessions happen in homes, schools, hospitals or detention.",
    "wellness_emotional_trauma_informed": "Ongoing training from trauma specialists keeps therapy informal and relational for youth who would not otherwise engage; tools include sand tray and an EMDR protocol being adapted for community settings.",
    "wellness_emotional_clinical_referral": "Referrals to in-home or outpatient therapy, psychological and neuropsychological testing, and DMH applications; social workers file the paperwork, sit with parents at appointments and bring youth to evaluations."
  },
  "occupational": {
    "sub_occupational_3": "A social worker builds a first resume with a young person from babysitting, painting or yard work, then accompanies them to the interview and can provide professional clothing."
  },
  "social": {
    "sub_social_1": "A social worker walks the young person into an after-school center, basketball team or Boston Center for Youth and Families, handles the introductions, and follows up so a positive adult sticks.",
    "sub_social_2": "One referral brings in the whole household: parents connected to employment, medical or mental health care, younger siblings to camp, and help navigating school, hospital and legal systems."
  },
  "spiritual": {
    "sub_spiritual_1": "Mindfulness and meditation are worked into the group sessions run on the detention units and at the Charlestown education program.",
    "wellness_spiritual_mindfulness_embedded": "The same mindfulness practices carry into one-to-one sessions, and spirituality is explored further when a young person chooses to raise it."
  }
}