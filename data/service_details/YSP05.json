"YSP05": {
  "intellectual": {
    "sub_intellectual_1": "Academic workshops run through the school year and intensively over the summer for middle schoolers, previewing the next grade's curriculum so students start the year ahead.",
    "sub_intellectual_2": "Monthly workshops through the school year, plus a dedicated week when rising seniors work on college applications; support continues into college for as long as students want it.",
    "sub_intellectual_3": "After-school support during the school year for students who need it, which in practice often takes the form of tutoring in current coursework.",
    "wellness_intellectual_creative_arts": "Arts and crafts clubs and project-based classes run through summer programming, where creative work is most concentrated; high school Saturdays include free time for crafts and board games."
  },
  "occupational": {
    "sub_occupational_1": "A high school intern program for underclassmen and Junior Teacher roles for upperclassmen leading in classrooms, plus a database of Boston jobs and programs out of state and abroad.",
    "sub_occupational_2": "Post-secondary advisors hold one-on-one check-ins with college students and alumni on job searching and salary negotiation; a February or April break each year is given to career exploration.",
    "sub_occupational_3": "Resumes are workshopped on Super Saturdays, the roughly six monthly high school sessions where students also sit down and apply for jobs on the spot.",
    "wellness_occupational_stipend": "Rising ninth graders in the summer Leadership Academy are paid at the end of the season for campus leadership: peer mentoring, helping at snack, interning for a day.",
    "wellness_occupational_mock_interviews": "Practice interviews sit inside the monthly high school career and college exploration curriculum, giving students a rehearsal before the applications they submit in the same sessions."
  },
  "financial": {
    "sub_financial_1": "High school is where money conversations start: how to save a first paycheck and what to do with it, as students begin earning through summer positions.",
    "sub_financial_2": "Workshops on scholarships such as Posse and QuestBridge, plus a financial aid calculator that helps students work out what a college award letter actually means.",
    "sub_financial_3": "Students vote on choice workshop topics; a recent one covered taxes and their effect on a paycheck, and others cover talking with family about what college costs.",
    "wellness_financial_emergency_fund": "The Bridge the Gap Fund covers emergency costs once students reach college: a replacement laptop, a semester of books, or a small gap between aid and tuition."
  }
}