"YSP08": {
  "intellectual": {
    "sub_intellectual_1": "Workshops run regularly and are often outsourced to partners such as the Mirror Project, including Know Your Rights sessions where youth can ask immigration questions directly.",
    "sub_intellectual_2": "A career services manager sits with each young person on school applications, joins campus site visits, and coordinates meetings with staff at the institution."
  },
  "occupational": {
    "sub_occupational_2": "Each young person is paired with a youth development or career services manager and meets weekly, planning the move into employment beyond More Than Words.",
    "sub_occupational_4": "Readiness is a six-to-twelve-week introductory program every new young person completes, building the professionalism, punctuality and dress-code habits the job itself will expect.",
    "wellness_occupational_stipend": "Young people hold two jobs: a business job in the retail shop, trucks or online bookstore, and a You job working toward personal goals."
  },
  "financial": {
    "sub_financial_1": "Managers build a budget with the young person when support tapers off, for example covering a first month of phone service and planning the handover.",
    "sub_financial_2": "Career services managers sit with young people to complete the FAFSA, part of the same one-on-one help offered when applying to college or training programs.",
    "sub_financial_3": "Financial trainings are largely outsourced to expert partners, with banks running sessions on checking versus savings accounts and which products suit a given young person.",
    "wellness_financial_emergency_fund": "Just in Time Funds cover urgent needs like a bus pass, a bed or groceries, and grocery gift cards went to every young person when SNAP lapsed."
  },
  "social": {
    "wellness_social_youth_council": "Changemakers brings youth together each year to change organizational policy directly; one group rewrote the attendance policy, including how tallies and strikes work."
  }
}