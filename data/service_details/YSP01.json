"YSP01": {
  "physical": {
    "wellness_physical_meals": "Fruit, bread and cheese at every school workshop, sandwiches at apprenticeships, and full cooked meals at the end-of-cohort celebration, chosen as whole rather than processed foods."
  },
  "intellectual": {
    "wellness_intellectual_social_justice": "A social justice apprenticeship group presented on Bad Bunny's use of music for change; workshops also examine which professionalism norms are rooted in white supremacy."
  },
  "occupational": {
    "wellness_occupational_stipend": "Apprenticeships pay a $200 stipend across the twelve-week program; City Summer Internship runs six to eight weeks for about forty girls at roughly $550 weekly."
  },
  "financial": {
    "wellness_financial_stipend_empowerment": "Paid alongside covered transport between school and placements, so earnings stay intact; a check-cashing worksheet and Eastern Bank IDs help students access their money."
  }
}