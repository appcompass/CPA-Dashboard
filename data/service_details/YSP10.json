"YSP10": {
  "emotional": {
    "sub_emotional_1": "An eight-week Caregivers healing cohort for youth and women affected by incarceration or community harm; members support one another, then graduate into a mentor phase.",
    "sub_emotional_2": "After a shooting nearby, separate youth and adult teams run healing circles in the affected area, three following one recent Roxbury incident, plus door-to-door flyers.",
    "sub_emotional_3": "Counseling is delivered on site by a lead clinician and a staff of clinicians, open to youth and to families connected through our programs.",
    "wellness_emotional_trauma_informed": "Facilitators follow a guide developed with a consulting doctor, saying community harm rather than homicide, and refresh it in workshops run with the City of Boston.",
    "wellness_emotional_clinical_referral": "Referrals reach our clinicians from the Boston Police Department and the City of Boston, and families are connected onward to partner organizations for services we do not run."
  },
  "occupational": {
    "sub_occupational_2": "Facilitators ask which fields interest youth, map college and technical-school routes, and bring in local professionals, a hair salon owner for instance, to talk about that work.",
    "sub_occupational_3": "Resume workshops sit inside the youth mentorship program, alongside professionalism and career-advancement sessions, so participants finish the cohort with a resume in hand.",
    "sub_occupational_4": "Job-sustainability workshops cover workplace responsibilities, raising a problem with a manager, presentation do's and don'ts, and norms such as phone use during a shift."
  }
}