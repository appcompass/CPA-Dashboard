"YSP09": {
  "physical": {
    "wellness_physical_fitness": "Twenty-three Olympic-style sports, free and open to youth with and without disabilities, each with a six-to-eight-week introductory clinic and a competitive arm that travels to other cities.",
    "wellness_physical_nutrition": "Most program sites offer healthy snacks alongside food knowledge resources: pointers to local food pantries, guidance on daily water intake, and basic nutrition charts.",
    "wellness_physical_movement": "Young Athletes develops fine and gross motor skills for ages two to seven. Train for Life is a twelve-week strength and conditioning program built with Vanderbilt University clinicians."
  },
  "social": {
    "sub_social_2": "Take-home activity materials in several languages let families run the program at home when they cannot get to a site. Parent and community leadership groups guide neighborhood outreach.",
    "sub_social_3": "Unified bowling nights, open houses, pizza parties, movie nights, joint volunteer projects and dances at the summer games and state competitions, for people with and without disabilities.",
    "wellness_social_peer_mentoring": "Athletes are paired with neurotypical partners on rosters split evenly, with volunteer team escorts at competitions and, in some programs, accountability buddies who check in between practices."
  }
}