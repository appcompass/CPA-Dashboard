"YSP12": {
  "emotional": {
    "sub_emotional_2": "Triggered by repeating patterns rather than one-off incidents, such as a young person disengaging from learning; staff work with school social workers to confirm the concern appears in more than one setting.",
    "wellness_emotional_clinical_referral": "Staff refer families to outside professionals sourced through schools, parents and partner meetings, including a Haitian psychiatrist for the center's large Haitian community and a partner organization that makes home visits."
  },
  "intellectual": {
    "sub_intellectual_1": "Free computer classes run from the site's computer center, open to teens and to their parents, since the program extends its services to whole families."
  },
  "occupational": {
    "sub_occupational_1": "High school students who need community service hours for a course requirement can complete them on site at Georgetowne.",
    "sub_occupational_3": "Free resume writing for teens and for their parents, with staff also available to help families through summer job applications.",
    "sub_occupational_4": "Career exploration and job training workshops for teens, backed by guest speakers from different professions, including an attorney last year and a further lineup this year."
  },
  "financial": {
    "sub_financial_3": "A mostly online course covering saving, opening a bank account and writing a check, with a certificate on completion; staff also pass on the Boston Public Schools family savings account."
  },
  "social": {
    "sub_social_1": "In-house mentoring is informal, built through years of relationship with staff; more formal mentoring matches are usually arranged through the young person's school.",
    "sub_social_3": "Weekly social activities open to all ages, from dance to health sessions to college visits, plus community events that whole families are invited to attend.",
    "wellness_social_youth_council": "A youth council running several years gives teens of any age a place to raise needs; staff hear every side before decisions and coach youth to advocate for themselves."
  }
}