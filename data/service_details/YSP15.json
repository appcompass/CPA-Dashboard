"YSP15": {
  "intellectual": {
    "wellness_intellectual_creative_arts": "Semester-long hands-on programs in songwriting, performance and instrumental music, plus production, videography, engineering and a youth-powered low-power FM radio station; groups meet two to four hours weekly on shared projects."
  },
  "occupational": {
    "sub_occupational_1": "Medium-specific internships follow the introductory sound or video class, moving youth into paid gig work in that field, with an abundant number of gigs to opt into.",
    "sub_occupational_3": "Part of the weekly professional-development session for Leaders in Training, the paid youth cohort who co-facilitate Zumix programs.",
    "sub_occupational_4": "Sound engineering learned in programs becomes a working skill: youth run live sound for the community groups and artists who perform in Zumix's space.",
    "wellness_occupational_stipend": "A summer jobs program with the City of Boston and the City of Revere places about 20 young people in 20 to 25 hour weeks of cohort learning and concert-series support."
  },
  "social": {
    "sub_social_2": "Community arts events are deliberately all-ages, keeping families connected to their young people's work; recent examples include a dance film screening and a Mother's Day concert.",
    "sub_social_3": "An outdoor concert series runs in Pierce Park each summer, open to everyone and often how neighbors first meet Zumix; other community groups also program events in Zumix's space.",
    "wellness_social_youth_council": "Teen Council brings together youth from across Zumix's programs, meeting every Friday to plan community arts events, advise staff on organizational questions, and propose projects of their own.",
    "wellness_social_peer_mentoring": "Every program pairs an adult co-facilitator with a youth co-facilitator from the Leaders in Training cohort, who design the agenda and curriculum together."
  }
}